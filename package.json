{
  "name": "pty-bridge",
  "version": "1.4.0",
  "description": "Manage interactive terminal sessions (SSH, REPLs, databases, TUI apps) via CLI. Designed for AI agents that need PTY support.",
  "keywords": [
    "pty",
    "terminal",
    "ssh",
    "repl",
    "tui",
    "cli",
    "agent",
    "ai",
    "node-pty",
    "interactive"
  ],
  "bin": {
    "pty-bridge": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/integration.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@xterm/headless": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briqt/pty-bridge.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
