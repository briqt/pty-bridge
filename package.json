{
  "name": "pty-bridge",
  "version": "1.7.1",
  "description": "Manage interactive terminal sessions (SSH, REPLs, databases, TUI apps) via CLI. Designed for AI agents that need PTY support.",
  "keywords": [
    "pty",
    "terminal",
    "ssh",
    "repl",
    "tui",
    "cli",
    "agent",
    "ai",
    "node-pty",
    "interactive"
  ],
  "bin": {
    "pty-bridge": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/output.test.js test/exec-output.test.js test/updater.test.js && node test/integration.js"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/headless": "6.0.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briqt/pty-bridge.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2"
  }
}
